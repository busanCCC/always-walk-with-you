{
  "expo": {
    "name": "매일동행",
    "slug": "always-walk-with-you",
    "scheme": "alwayswalkwithyouauth",
    "version": "1.0.0",
    "description": "함께 쓰는 영성일기, 함께 걷는 믿음의 여정",
    "keywords": ["영성일기", "신앙", "감정기록", "일기", "기독교", "묵상"],
    "entryPoint": "./src/app/App.tsx",
    "web": {
      "favicon": "./src/assets/images/icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo-white.png",
          "backgroundColor": "#2584F0",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.363398054005-ehj5ic5g55jvk038ltqo65crooto3u5d"
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#2584F0",
      "image": "./src/assets/images/logo-white.png",
      "imageResizeMode": "contain"
    },
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cccbusan.alwayswalkwithyou",
      "statusBar": {
        "style": "dark",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
        "UIViewControllerBasedStatusBarAppearance": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.363398054005-ehj5ic5g55jvk038ltqo65crooto3u5d"
            ]
          },
          {
            "CFBundleURLName": "custom-auth",
            "CFBundleURLSchemes": ["alwayswalkwithyouauth"]
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#2584F0"
      },
      "package": "com.cccbusan.alwayswalkwithyou",
      "versionCode": 5,
      "statusBar": {
        "backgroundColor": "#ffffff"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yrklwyajimcbotusopye.supabase.co"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "1e55cb2e-d86f-43b1-972c-a68d69aee6e1"
      }
    }
  }
}
